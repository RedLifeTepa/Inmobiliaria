rules_version = '2';
// RPM Inmobiliario V12.0 - archivos limitados por autenticacion, rol, tipo y ruta.

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'administrador', 'direccion', 'asesor', 'cobranza', 'consulta'];
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'administrador'];
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /branding/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
    }

    match /properties/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if isStaff() && validImage();
    }

    match /documents/{allPaths=**} {
      allow read, write: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
